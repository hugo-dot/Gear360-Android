<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.SimpleCameraActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/simple_camera_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/simple_camera_title"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/simple_camera_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="44dp"
            android:text="@string/simple_camera_status_waiting"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/simple_camera_bluetooth"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="@string/simple_camera_bluetooth_placeholder"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/simple_camera_wifi"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="@string/simple_camera_wifi_placeholder"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>

        <TextView
            android:id="@+id/simple_camera_battery"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:text="@string/simple_camera_battery_placeholder"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/simple_camera_mode"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:text="@string/simple_camera_mode_placeholder"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/simple_camera_recording"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:text="@string/simple_camera_recording"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pair_classic"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/pair_bluetooth"
                app:icon="@drawable/ic_baseline_bluetooth_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_connect_camera"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/connect_camera"
                app:icon="@drawable/ic_baseline_network_wifi_24" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_connect_camera_wifi"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/connect_camera_wifi"
            app:icon="@drawable/ic_baseline_network_wifi_24" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/simple_capture_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:singleSelection="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_take_simple_photo"
                style="@style/Widget.App.Button.OutlinedButton.IconOnly"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/mode_photo"
                app:icon="@drawable/ic_baseline_photo_camera_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_simple_video"
                style="@style/Widget.App.Button.OutlinedButton.IconOnly"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/start_video"
                app:icon="@drawable/ic_baseline_videocam_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_stop_simple_video"
                style="@style/Widget.App.Button.OutlinedButton.IconOnly"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/stop_video"
                app:icon="@drawable/baseline_movie_24" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/simple_camera_folder_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/transfer_folder_label"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/simple_camera_folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="40dp"
            android:text="@string/no_transfer_folder"
            android:textColor="?android:attr/textColorSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_choose_transfer_folder"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/choose_folder"
            app:icon="@drawable/baseline_sd_storage_24" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_auto_transfer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/auto_transfer"
            android:textColor="?android:attr/textColorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_import_media_now"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/import_now"
            app:icon="@drawable/baseline_image_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_gallery"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/gallery"
            app:icon="@drawable/ic_baseline_widgets_24" />

        <ProgressBar
            android:id="@+id/simple_camera_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
